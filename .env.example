# ═══════════════════════════════════════════
# MasterD Quant Agent — Environment Configuration
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════

# ── Binance API ──
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# ── DeepSeek AI ──
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ── BSC / Trader ──
TRADER_PRIVATE_KEY=your_bsc_trader_private_key_here

# ── Platform ──
PLATFORM_WALLET=your_platform_fee_wallet_address
PLATFORM_FEE_BPS=2000

# ── Server ──
PORT=10000
ADMIN_KEY=your_admin_secret_key

# ── 境外云部署安全（重要！）──
# PRIVATE_ACCESS=yes: 所有 HTTP 服务只监听 127.0.0.1（默认，最安全）
#   通过 SSH 隧道访问：ssh -L 10000:127.0.0.1:10000 user@server
# PRIVATE_ACCESS=no: 公网暴露（不推荐，除非已配置防火墙+IP白名单）
PRIVATE_ACCESS=yes
# ALLOWED_IPS: 可选，仅允许指定 IP 访问（逗号分隔）
# ALLOWED_IPS=1.2.3.4,5.6.7.8

# ── Database (optional, future) ──
DATABASE_URL=

# ── 百万级架构 (v83) ──
# WORKERS=0      单进程(默认) | auto=CPU核数-1 | N=指定数量
WORKERS=0
# DATA_STORE=json(默认) | redis(大配置)
DATA_STORE=json
# REDIS_URL=redis://127.0.0.1:6379
# API Rate Limit (Binance 1200权重/分钟)
API_RATE_LIMIT=1200

# ── Logging ──
LOG_LEVEL=info
