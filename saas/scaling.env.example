# ═══════════════════════════════════════════
#  架构配置 — 通过环境变量切换
# ═══════════════════════════════════════════
#
#  小配置 (1-100 用户):  用默认值即可，不需要改任何东西
#  中配置 (100-1000):    WORKERS=2, DATA_STORE=json
#  大配置 (1000-10000):  WORKERS=4, DATA_STORE=redis, REDIS_URL=redis://...
#  超大配置 (10000+):    见文档，需要微服务化
#
# ═══════════════════════════════════════════

# ── Worker 数量 ──
# 0 或空 = 单进程 (推荐小配置)
# auto = 自动检测 CPU 核数
# 数字 = 指定 Worker 数量
WORKERS=0

# ── 数据存储 ──
# json = JSON 文件 (默认，零依赖)
# redis = Redis (100+ 用户推荐)
DATA_STORE=json
REDIS_URL=redis://127.0.0.1:6379

# ── API 限速 ──
# 单 IP 限制: 1200 权重/分钟
# 如果有多个 API Key，配置逗号分隔
# BINANCE_KEYS=key1:secret1,key2:secret2
BINANCE_KEYS=

# ── CEX 检查周期 (毫秒) ──
# 小配置: 30000 (30秒)
# 大配置: 60000 (1分钟，减少 API 调用)
CEX_CYCLE_MS=30000
