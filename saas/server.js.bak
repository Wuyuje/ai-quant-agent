/**
 * SaaS Platform v3.0 — 智能合约钱包模式
 * 
 * 核心变化：
 *   - 用户不再需要 Binance API Key
 *   - 用户部署 AgentVault 智能合约 → 存入资金 → 授权 trader
 *   - 平台 trader 用统一资金在 PancakeSwap 上为用户交易
 *   - 收益直接在 Vault 合约里结算
 *
 * 用户流程：
 *   1. TP 钱包签名登录
 *   2. 一键部署 Vault（链上合约）
 *   3. 转入 USDT 到 Vault
 *   4. 点击「开启自动交易」→ 确认授权
 *   5. 全自动交易
 *   6. 随时提现
 */

const express = require('express');
const path = require('path');
const fs = require('fs');
const http = require('http');
const https = require('https');
const crypto = require('crypto');

// v14: nonce 防重放
const _usedNonces = new Map(); // nonce → expireTime
function isNonceUsed(nonce) {
  return _usedNonces.has(nonce);
}
function markNonceUsed(nonce) {
  _usedNonces.set(nonce, Date.now() + 300000); // 5分钟过期
  // 清理旧 nonce
  if (_usedNonces.size > 500) {
    const now = Date.now();
    for (const [k, v] of _usedNonces) { if (v < now) _usedNonces.delete(k); }
  }
}

// v14: 简易内存限流器 (IP → {count, resetAt})
const _rateLimits = new Map();
function rateLimit(key, maxHits = 10, windowMs = 60000) {
  const now = Date.now();
  const entry = _rateLimits.get(key);
  if (!entry || now > entry.resetAt) {
    _rateLimits.set(key, { count: 1, resetAt: now + windowMs });
    return true;
  }
  entry.count++;
  if (entry.count > maxHits) return false;
  return true;
}

// ─── 配置 ───
const BSC_RPC = 'https://bsc-dataseed.binance.org';
const PANCAKE_ROUTER = '0x10ED43C718714eb63d5aA57B78B54704E256024E';
const USDT_ADDRESS = '0x55d398326f99059fF775485246999027B3197955';
const WBNB_ADDRESS = '0xbb4CdB9CBd36B01bD1cBaEBF2De08d9173bc095c';
const ARK_TOKEN = '0xCae117ca6Bc8A341D2E7207F30E180f0e5618B9D';
const PLATFORM_WALLET = '0xb6DEb31484353AdDaA5b6A105A2B758Df11bC28A';  // 服务费接收地址
const PLATFORM_FEE_BPS = 2000; // 20%
const MIN_ARK_USD = 100; // 最低门槛：等值 100 USDT 的 ARK

// ═══════ 平台 ARK 余额门槛验证函数 ═══════
// 任何登录方式（签名/密码/注册）统一使用此函数验证
async function verifyArkThreshold(address, log) {
  // 1. 查 ARK 余额
  let arkBalance = 0;
  const rpcs = [BSC_RPC, 'https://bsc-dataseed1.binance.org', 'https://bsc-dataseed2.binance.org'];
  for (let attempt = 0; attempt < rpcs.length; attempt++) {
    try {
      const rawArk = await erc20Balance(ARK_TOKEN, address, rpcs[attempt]);
      arkBalance = Number(rawArk) / 1e18;
      log(`🔍 ARK余额: ${address.slice(0,10)}... → ${arkBalance.toFixed(4)} ARK (via ${rpcs[attempt].replace('https://','')})`);
      break;
    } catch (e) {
      log(`⚠️ RPC ${attempt+1} 失败 ${rpcs[attempt].replace('https://','')}: ${e.message}`);
      if (attempt === rpcs.length - 1) log(`❌ 所有 RPC 节点均失败，ARK余额设为0`);
    }
  }
  // 2. 查 ARK 实时价格，计算等值 USDT
  const arkPriceUsd = await getArkPriceUsd();
  const arkValueUsd = arkBalance * arkPriceUsd;
  // 3. 判断门槛：持有 ARK 代币等值 ≥ 100 USDT
  if (arkValueUsd < MIN_ARK_USD) {
    const shortMsg = `ARK 持仓不足`;
    const detailMsg = `钱包: ${address}\nARK: ${arkBalance.toFixed(4)} ARK (≈ $${arkValueUsd.toFixed(2)})\n需要: ≥ $${MIN_ARK_USD}\n价格: $${arkPriceUsd.toFixed(4)}\n\n如果您确认持有 ARK，\n请截图此信息联系管理员`;
    log(`❌ 登录拒绝 ${address.slice(0,10)}... | ARK: ${arkBalance.toFixed(4)} | $${arkValueUsd.toFixed(2)} | price: $${arkPriceUsd.toFixed(4)}`);
    return { ok: false, error: shortMsg, detail: detailMsg, arkBalance, arkPriceUsd, arkValueUsd, minUsd: MIN_ARK_USD };
  }
  log(`✅ ARK门槛通过: ${arkBalance.toFixed(2)} ARK ≈ $${arkValueUsd.toFixed(2)}`);
  return { ok: true, arkBalance, arkPriceUsd, arkValueUsd };
}
// 动态获取 ARK 价格（Dexscreener API）
let _arkPriceCache = { price: 7.97, ts: 0 };
async function getArkPriceUsd() {
  const now = Date.now();
  // 5 分钟缓存
  if (_arkPriceCache.price > 0 && now - _arkPriceCache.ts < 300000) return _arkPriceCache.price;
  try {
    const resp = await fetch('https://api.dexscreener.com/latest/dex/pairs/bsc/0xCAaF3c41a40103a23Eeaa4BbA468AF3cF5b0e0D8');
    const data = await resp.json();
    const price = parseFloat(data?.pair?.priceUsd) || 0;
    if (price > 0) { _arkPriceCache = { price, ts: now }; return price; }
  } catch (e) { /* fallback */ }
  return _arkPriceCache.price; // fallback to last known
}
// ARK 余额检查改为 USDT 等值（≥ $100）
// MIN_ARK 已废弃，统一用 MIN_ARK_USD（等值 100 USDT）作为门槛

